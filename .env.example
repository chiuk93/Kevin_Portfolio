# Reddit script-app credentials — create one at https://www.reddit.com/prefs/apps
# (choose type "script"; redirect URI can be http://localhost:8080)
# Scan mode (the default) only needs these two:
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Only needed for --history mode (mining your own saved/upvoted items).
# If your account has 2FA, use "yourpassword:123456" with the current TOTP code.
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Anthropic API key — https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional overrides
# RECALL_MODEL=claude-opus-5
# RECALL_SUBREDDITS=ClaudeCode,ClaudeAI
# RECALL_TIME_FILTER=week        # hour/day/week/month/year/all
# RECALL_POST_LIMIT=25           # posts per subreddit per run
# RECALL_STALE_DAYS=14
